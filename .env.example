# Tidewall environment configuration
# Copy to .env and adjust as needed: cp .env.example .env

# Authentication (disabled by default for local development)
AUTH_ENABLED=false

# Database (SQLite, stored in data/ directory)
DB_URL=sqlite:///data/tidewall.db

# Policy file used to seed the database on first boot
POLICY_FILE=policy.yaml

# Logging verbosity: debug, info, warning, error
LOG_LEVEL=info

# OpenAI API key (used by SDK/OTel demo — make demo)
OPENAI_API_KEY=sk-...

# Elastic APM / OTel export (Demo 4 — get from Kibana → Observability → APM → Add data → OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-project.ingest.us-central1.gcp.elastic.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey your-api-key-here
OTEL_SERVICE_NAME=tidewall-demo
